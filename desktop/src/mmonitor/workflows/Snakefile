# MMonitor Snakemake Workflow
# Main entry point for all MMonitor pipelines
#
# Supports both single-sample and multi-sample (sample sheet) modes.
#
# Single sample:
#   Config provides sample_name + input_fastq
#
# Multi-sample (sample sheet):
#   Config provides samples dict: {"sample1": {"fastq": ["/path/to/reads.fastq"]}, ...}
#
# Usage:
#   snakemake --configfile config/myconfig.yaml --cores 8 taxonomy_16s
#   snakemake --configfile config/myconfig.yaml --cores 8 taxonomy_wgs
#   snakemake --configfile config/myconfig.yaml --cores 8 assembly
#   snakemake --configfile config/myconfig.yaml --cores 8 functional

import os
from pathlib import Path

# ============ Configuration ============
configfile: "config/config.yaml"

# Output and database directories
OUTPUT_DIR = Path(config.get("output_dir", "results"))
OUTDIR = str(OUTPUT_DIR)
DB_BASE = Path(config.get("db_base_dir", os.path.join(os.path.expanduser("~"), "mmonitor_databases")))

# ============ Sample Configuration ============
# Build SAMPLES dict from either:
#   1. config["samples"] - multi-sample mode (from sample sheet or GUI)
#   2. config["sample_name"] + config["input_fastq"] - single sample (backwards compat)
if "samples" in config and config["samples"]:
    SAMPLES = config["samples"]
else:
    _sample_name = config.get("sample_name", "sample")
    _input_fastq = config.get("input_fastq", "")
    SAMPLES = {
        _sample_name: {
            "fastq": _input_fastq,
        }
    }

# Legacy: keep SAMPLE for single_genome.smk which uses it as a global
SAMPLE = config.get("sample_name", list(SAMPLES.keys())[0])

# Validate input
if not SAMPLES:
    print("Warning: No samples configured")

# ============ Helper Functions ============
def get_input_fastq(wildcards):
    """Get input FASTQ file(s) for a sample"""
    fastq = SAMPLES[wildcards.sample]["fastq"]
    if isinstance(fastq, list):
        return fastq
    return [fastq] if fastq else []

def get_filtered_reads(wildcards):
    """Get filtered or unfiltered reads based on config"""
    if config.get("filtlong", {}).get("enabled", True):
        return OUTDIR + f"/{wildcards.sample}/filtered/filtered.fastq.gz"
    else:
        return OUTDIR + f"/{wildcards.sample}/filtered/unfiltered.fastq.gz"

def get_threads(rule_name):
    """Get threads for a specific rule, falling back to global default"""
    rule_config = config.get(rule_name, {})
    if isinstance(rule_config, dict):
        return rule_config.get("threads", config.get("threads", 4))
    return config.get("threads", 4)

# ============ Include Pipeline Rules ============
include: "rules/common.smk"
include: "rules/database_setup.smk"
include: "rules/taxonomy_16s.smk"
include: "rules/taxonomy_wgs.smk"
include: "rules/assembly.smk"
include: "rules/binning.smk"
include: "rules/annotation.smk"
include: "rules/functional_annotation.smk"
include: "rules/single_genome.smk"

# ============ Target Rules ============
rule all:
    """Default target - show help"""
    run:
        print("""
MMonitor Snakemake Workflows
============================

Analysis pipelines:
  taxonomy_16s   - 16S rRNA taxonomy (EMU)
  taxonomy_wgs   - Whole genome taxonomy (Centrifuger)
  assembly       - Assembly + binning + taxonomy + annotation + upload
                   (Flye -> Medaka -> MetaBAT2 -> CheckM2 -> GTDB-TK -> Bakta -> upload)
  assembly_full  - Assembly + functional analysis + upload
                   (Everything in assembly + eggNOG + InterProScan -> upload MAGs)

Single genome:
  annotate_genome - Annotate a single genome with Bakta and upload

Database setup:
  setup_databases_16s      - Download EMU database
  setup_databases_assembly - Download CheckM2, GTDB-TK, Bakta, eggNOG databases
  setup_all_databases      - Download all databases

Multi-sample:
  Provide a samples dict in config or use --sample-sheet in the CLI.
  All samples are processed in parallel.

Usage:
  snakemake --configfile config/myconfig.yaml --cores 8 taxonomy_16s
        """)

rule taxonomy_16s:
    """16S rRNA taxonomy analysis using EMU"""
    input:
        expand(OUTDIR + "/{sample}/taxonomy_16s/emu_results.json", sample=SAMPLES.keys())

rule taxonomy_wgs:
    """Whole genome taxonomy analysis using Centrifuger"""
    input:
        expand(OUTDIR + "/{sample}/taxonomy_wgs/centrifuger_results.json", sample=SAMPLES.keys())

rule assembly:
    """Assembly + binning + quality + taxonomy + annotation + upload.

    Flye assembly -> Medaka polishing -> MetaBAT2 binning -> CheckM2 quality ->
    GTDB-TK taxonomy -> Bakta annotation -> upload to server.
    """
    input:
        expand(OUTDIR + "/{sample}/annotation/annotation_complete.json", sample=SAMPLES.keys())

rule assembly_full:
    """Full assembly + functional analysis pipeline.

    Everything in 'assembly' plus:
    eggNOG-mapper (COG/KEGG) -> InterProScan (PFAM) -> upload MAGs with functional data.
    """
    input:
        expand(OUTDIR + "/{sample}/functional/functional_analysis_complete.json", sample=SAMPLES.keys())

rule annotate_genome:
    """Annotate a single genome with Bakta and upload to server"""
    input:
        lambda wildcards: expand(
            str(OUTPUT_DIR / SAMPLE / "upload" / "{genome_id}_complete.json"),
            genome_id=config.get("genome_ids", [config.get("genome_id", "input_genome")])
        )

# ============ Utility Rules ============
rule clean:
    """Remove all output files for all samples"""
    shell:
        "rm -rf " + " ".join([OUTDIR + "/" + s for s in SAMPLES.keys()])

rule clean_intermediate:
    """Remove intermediate files, keep final results"""
    shell:
        " ; ".join([
            f'find {OUTDIR}/{s} -name "*.sam" -delete ; '
            f'find {OUTDIR}/{s} -name "*.bam" -delete ; '
            f'find {OUTDIR}/{s} -name "*_filtered.fastq" -delete'
            for s in SAMPLES.keys()
        ])
