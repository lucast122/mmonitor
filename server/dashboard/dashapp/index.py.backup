        @self.app.callback(
            Output('circos-plot', 'children'),
            [
                Input('mag-table', 'selected_rows'),
                Input('gene-search-button', 'n_clicks')
            ],
            [State('mag-table', 'data'),
             State('gene-search', 'value')],
            prevent_initial_call=False
        )
        def update_circos_plot(selected_rows, search_clicks, table_data, search_term):
            """Update the circos plot based on the selected MAG."""
            ctx = dash.callback_context
            if not ctx.triggered:
                return html.Div("Select a MAG from the table to view the circos plot.", className="alert alert-info")
            
            try:
                if not selected_rows or not table_data:
                    return html.Div("Select a MAG from the table to view the circos plot.", className="alert alert-info")
                
                selected_row = table_data[selected_rows[0]]
                if self.mags_app:
                    return self.mags_app.create_dashbio_circos_plot(selected_row)
                else:
