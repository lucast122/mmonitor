        # CSS styling is handled through inline styles

    def _create_mags_content(self):
        """Create the MAGs content."""
        return html.Div([
            # Display warnings
            html.Div(id='mag-genome-warning', className="alert alert-warning", style={'display': 'none'}),
            
            # Top controls
            html.Div([
                html.Div([
                    html.Label("Visualization Type"),
                    dcc.RadioItems(
                        id='viz-toggle',
                        options=[
                            {'label': 'Genome Browser', 'value': 'browser'},
                            {'label': 'CIRCOS Plot', 'value': 'circos'}
                        ],
                        value='browser',
                        labelStyle={'display': 'inline-block', 'marginRight': '10px'}
                    )
                ], style={'flex': 1})
            ], style={'display': 'flex', 'marginBottom': '20px'}),
            
            # Rest of the MAG content
            html.Div(id='mag-content'),
            
            # Add gene content plot section
            html.Div([
                html.H4("Gene Content Distribution", className="section-title"),
                dcc.Graph(id='gene-content-plot', style={'height': '400px'})
            ], className="section-container", style={'marginTop': '20px'}),
            
            # MAG info section
            html.Div(id='mag-info-section', style={'display': 'none'}, children=[
                # Overview section
                html.Div([
                    html.H4("MAG Overview", className="section-title"),
                    html.Div(id='mag-overview', className="overview-container")
                ], className="section-container"),
                
                # Genome section
                html.Div([
                    html.H4("Genome Visualization", className="section-title"),
                    html.Div([
                        # Controls for sequence viewer
                        html.Div([
                            dcc.Dropdown(id='sequence-selector', placeholder="Select a contig...", style={'width': '100%'}),
                            dcc.RadioItems(
                                id='sequence-view-type',
                                options=[
                                    {'label': 'Whole Genome', 'value': 'whole-genome'},
                                    {'label': 'Features', 'value': 'features'}
                                ],
                                value='whole-genome',
                                labelStyle={'display': 'inline-block', 'marginRight': '10px'}
                            ),
                            html.Div([
                                html.Button("Copy All", id="copy-all-button", className="btn btn-sm btn-primary"),
                                html.Div(id="copy-status", style={'marginLeft': '10px', 'display': 'inline-block'})
                            ], style={'marginTop': '10px'})
                        ], style={'marginBottom': '15px'}),
                        
                        # Sequence viewer container
                        html.Div(id='sequence-viewer-container', style={'border': '1px solid #ddd', 'borderRadius': '5px', 'padding': '10px'}),
                        
                        # Add download buttons container
                        html.Div([
                            html.Button("Download Genome (FASTA)", id="download-genome-button", className="btn btn-primary mr-2"),
                            html.Button("Download Annotations (GFF)", id="download-annotations-button", className="btn btn-secondary")
                        ], style={'marginTop': '15px'}),
                        dcc.Download(id="download-genome"),
                        dcc.Download(id="download-annotations")
                    ], className="content-section")
                ], className="section-container"),
                
                # Genome analysis
                html.Div([
                    html.H4("Gene Search", className="section-title"),
                    html.Div([
                        dcc.Input(id='gene-search', type='text', placeholder='Search for gene or product...', style={'width': '80%'}),
                        html.Button('Search', id='gene-search-button', className="btn btn-primary ml-2")
                    ], style={'marginBottom': '10px'}),
                    html.Div(id='gene-search-results')
                ], className="section-container"),
            ])
        ])
        