        @self.app.callback(
            Output("download-svg-taxonomy", "data"),
            [Input("btn-download-taxonomy-svg", "n_clicks")],
            [State("graph1", "figure"),
             State("width-input", "value"),
             State("height-input", "value")],
            prevent_initial_call=True
        )
        def download_taxonomy_svg(n_clicks, figure, width, height):
            """Download taxonomy figure as SVG."""
            if not n_clicks or not figure:
                raise PreventUpdate
                
            try:
                logger.info("Exporting taxonomy figure as SVG")
                
                # Make a copy of the figure to modify
                fig = figure.copy()
                
                # Apply width and height if provided
                if width and height:
                    fig['layout']['width'] = width
                    fig['layout']['height'] = height
                
                # Convert the figure to SVG format
                svg_data = pio.to_image(fig, format='svg')
                
                # Generate the timestamp for the filename
                timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
                filename = f"taxonomy_plot_{timestamp}.svg"
                
                # Return the SVG data
                return dict(
                    content=svg_data.decode('utf-8'),
                    filename=filename
                )
            except Exception as e:
                logger.error(f"Error exporting taxonomy SVG: {str(e)}", exc_info=True)
                raise PreventUpdate

        @self.app.callback(
            Output("download-csv", "data"),
            [Input("btn-download-csv-taxonomy", "n_clicks")],
            [State("sample-select-value-tax", "value")],
            prevent_initial_call=True
        )
        def download_taxonomy_csv(n_clicks, selected_samples):
            """Download all taxonomy data as CSV."""
            if not n_clicks or not selected_samples:
                raise PreventUpdate
                
            try:
                logger.info(f"Exporting full taxonomy data for {len(selected_samples) if selected_samples else 0} samples")
                # Filter data for selected samples
                df_filtered = self.taxonomy_app.df[self.taxonomy_app.df['sample_id'].isin(selected_samples)]
                
                # Get normalized counts
                normalized_counts_df = self.taxonomy_app.calculate_normalized_counts()
                
                # Merge with normalized counts (if available)
                if normalized_counts_df is not None and not normalized_counts_df.empty:
                    # Make sure to merge on the right columns
                    merge_columns = ['sample_id', 'taxonomy']
                    df_filtered = pd.merge(
                        df_filtered,
                        normalized_counts_df[['sample_id', 'taxonomy', 'normalized_count']],
                        on=merge_columns,
                        how='left'
                    )
                
                # Clean up the dataframe before export - exclude internal columns and fix formatting
                export_columns = [
                    'taxonomy', 'tax_genus', 'tax_family', 'tax_order', 'tax_class', 'tax_phylum', 'tax_superkingdom',
                    'sample_id', 'project_id', 'subproject', 'date',
                    'abundance', 'count', 'normalized_count'
                ]
                
                # Only include columns that exist in the dataframe
                export_columns = [col for col in export_columns if col in df_filtered.columns]
                
                # Create a clean export dataframe
                export_df = df_filtered[export_columns].copy()
                
                # Rename columns to be more descriptive
                column_renames = {
                    'abundance': 'relative_abundance',
                    'count': 'raw_count',
                    'normalized_count': 'normalized_count_per_10M_bases'
                }
                export_df.rename(columns={k: v for k, v in column_renames.items() if k in export_df.columns}, inplace=True)
                
                # Generate the timestamp for the filename
                timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
                filename = f"taxonomy_data_{timestamp}.csv"
                
                # Return the data as CSV
                return dict(
                    content=export_df.to_csv(index=False),
                    filename=filename
                )
            except Exception as e:
                logger.error(f"Error exporting taxonomy CSV: {str(e)}", exc_info=True)
                raise PreventUpdate

        @self.app.callback(
            Output("download-counts", "data"),
            [Input("btn-download-counts-taxonomy", "n_clicks")],
            [State("sample-select-value-tax", "value"),
             State("tax-rank-dropdown-tax", "value")],
            prevent_initial_call=True
        )
        def download_taxonomy_counts(n_clicks, selected_samples, tax_rank):
            """Download taxonomy count data as CSV."""
            if not n_clicks or not selected_samples:
                raise PreventUpdate
                
            try:
                logger.info(f"Exporting taxonomy count data for {len(selected_samples) if selected_samples else 0} samples")
                
                # Filter data for selected samples
                df_filtered = self.taxonomy_app.df[self.taxonomy_app.df['sample_id'].isin(selected_samples)]
                
                # Generate pivot table of counts by taxonomic rank
                if tax_rank not in df_filtered.columns and tax_rank != "species":
                    tax_rank = "species"  # Default to species if selected rank not found
                
                # For species level, we use the 'taxonomy' column
                pivot_column = tax_rank if tax_rank != "species" else "taxonomy"
                
                # Get normalized counts
                normalized_counts_df = self.taxonomy_app.calculate_normalized_counts()
                
                # If we have normalized counts, merge them into our filtered data
                if normalized_counts_df is not None and not normalized_counts_df.empty:
                    # Make sure to merge on the right columns
                    merge_columns = ['sample_id', 'taxonomy']
                    df_filtered = pd.merge(
                        df_filtered,
                        normalized_counts_df[['sample_id', 'taxonomy', 'normalized_count']],
                        on=merge_columns,
                        how='left'
                    )
                    
                    # Fill NA values with 0 for normalized_count
                    if 'normalized_count' in df_filtered.columns:
                        df_filtered['normalized_count'].fillna(0, inplace=True)
                
                # Create pivot tables for raw counts, abundances, and normalized counts (if available)
                raw_counts_pivot = df_filtered.pivot_table(
                    index=[pivot_column], 
                    columns=['sample_id'], 
                    values='count', 
                    aggfunc='sum',
                    fill_value=0
                )
                
                abundance_pivot = df_filtered.pivot_table(
                    index=[pivot_column], 
                    columns=['sample_id'], 
                    values='abundance', 
                    aggfunc='sum',
                    fill_value=0
                )
                
                # Add prefixes with clear descriptions to distinguish column types
                raw_counts_pivot.columns = [f"raw_count_{col}" for col in raw_counts_pivot.columns]
                abundance_pivot.columns = [f"relative_abundance_{col}" for col in abundance_pivot.columns]
                
                # Join the two pivot tables
                combined_pivot = raw_counts_pivot.join(abundance_pivot)
                
                # Add normalized counts if available
                if 'normalized_count' in df_filtered.columns:
                    normalized_counts_pivot = df_filtered.pivot_table(
                        index=[pivot_column], 
                        columns=['sample_id'], 
                        values='normalized_count', 
                        aggfunc='sum',
                        fill_value=0
                    )
                    normalized_counts_pivot.columns = [f"normalized_count_per_10M_bases_{col}" for col in normalized_counts_pivot.columns]
                    combined_pivot = combined_pivot.join(normalized_counts_pivot)
                
                # Generate the timestamp for the filename
                timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
                filename = f"taxonomy_counts_{tax_rank}_{timestamp}.csv"
                
                # Return the data as CSV
                return dict(
                    content=combined_pivot.reset_index().to_csv(index=False),
                    filename=filename
                )
            except Exception as e:
                logger.error(f"Error exporting taxonomy counts CSV: {str(e)}", exc_info=True)
                raise PreventUpdate
            
        @self.app.callback(
            Output('sequence-selector', 'options'),
            [Input('mag-table', 'selected_rows')],
            [State('mag-table', 'data')]
        )
        def update_sequence_options(selected_rows, table_data):
            """Update sequence selector dropdown options when a MAG is selected."""
            try:
                if not selected_rows or not table_data:
                    logger.warning("No rows selected or no table data available")
                    return []
                
                # Get selected row data
                selected_row = table_data[selected_rows[0]]
                logger.info(f"Selected row data: {selected_row}")
                
                # Find the MAG name - try both 'Name' and 'name' fields
                selected_mag_name = None
                for key in ['Name', 'name']:
                    if key in selected_row and selected_row[key]:
                        selected_mag_name = selected_row[key]
                        break
                
                if not selected_mag_name:
                    logger.error("Could not find name in selected row")
                    return []
                
                logger.info(f"Looking for MAG with name: '{selected_mag_name}'")
                
                # Get MAG data
                mag_data = self.mags_app.mag_data
                
                if mag_data is None or mag_data.empty:
                    logger.warning("mag_data is empty, trying to reload from database")
                    mag_data = self.mags_app.get_mag_data()
                    if mag_data is None or mag_data.empty:
                        logger.error("Failed to load MAG data from database")
                        return []
                
                # Try multiple approaches to find the matching MAG
                # First try exact match
                mag_matches = mag_data[mag_data['name'] == selected_mag_name]
                
                # If no exact match, try case-insensitive
                if mag_matches.empty:
                    mag_matches = mag_data[mag_data['name'].astype(str).str.lower() == selected_mag_name.lower()]
                    
                # If still no match, try contains
                if mag_matches.empty:
                    mag_matches = mag_data[mag_data['name'].astype(str).str.contains(selected_mag_name, case=False, na=False)]
                
                if mag_matches.empty:
                    logger.error(f"No MAG data found for '{selected_mag_name}'")
                    logger.info(f"Available MAGs: {mag_data['name'].tolist()[:5]}...")
                    return []
                
                # Get the first matching MAG
                mag_record = mag_matches.iloc[0]
                logger.info(f"Found MAG data: {mag_record['name']}")
                
                # Check if FASTA data exists
                if 'fasta_file' not in mag_record or not mag_record['fasta_file'] or mag_record['fasta_file'] == 'empty':
                    logger.error(f"No FASTA data found for MAG {selected_mag_name}")
                    return []
                    
                # Parse the FASTA data
                fasta_data = mag_record['fasta_file']
                sequences = self.mags_app.parse_fasta_for_viewer(fasta_data)
                
                if not sequences:
                    logger.error("No sequences parsed from FASTA data")
                    return []
                    
                # Create dropdown options
                options = []
                for record in sequences:
                    seq_id = record['id']
                    seq_len = len(record['sequence'])
                    options.append({
                        'label': f"{seq_id} ({seq_len:,} bp)", 
                        'value': seq_id
                    })
                    
                logger.info(f"Created {len(options)} dropdown options")
                return options
                
            except Exception as e:
                logger.error(f"Error in update_sequence_options: {str(e)}", exc_info=True)
                return []
        
        # Fix for sequence selector dropdown
        @self.app.callback(
            Output('sequence-selector', 'options'),
            [Input('mag-table', 'selected_rows')],
            [State('mag-table', 'data')]
        )
        def update_sequence_selector(selected_rows, table_data):
            """Update sequence selector dropdown options based on selected MAG."""
            if not selected_rows or not table_data:
                return []
                
            try:
                selected_row = table_data[selected_rows[0]]
                if not selected_row or not self.mags_app:
                    return []
                    
                # Get FASTA data
                fasta_data = selected_row.get('fasta_file', '')
                if not fasta_data:
                    return []
                    
                # Parse the FASTA to get sequences
                sequences = self.mags_app.parse_fasta_for_viewer(fasta_data)
                if not sequences:
                    return []
                    
                # Create dropdown options
                options = []
                for seq in sequences:
                    seq_id = seq.get('id', '')
                    length = len(seq.get('sequence', ''))
                    options.append({
                        'label': f"{seq_id} ({length:,} bp)",
                        'value': seq_id
                    })
                    
                # Sort by length (largest first)
                options = sorted(options, key=lambda x: int(x['label'].split('(')[1].split(' bp)')[0].replace(',', '')), reverse=True)
                
                return options
                
            except Exception as e:
                logger.error(f"Error updating sequence selector: {str(e)}", exc_info=True)
                return []
                
        # Set default sequence when options change
        @self.app.callback(
            Output('sequence-selector', 'value'),
            [Input('sequence-selector', 'options')],
            prevent_initial_call=True
        )
        def set_default_sequence(options):
            """Set the default sequence to the first option when options change."""
            if not options or len(options) == 0:
                return None
            return options[0]['value']

        @self.app.callback(
            Output('sequence-viewer-container', 'children'),
            [Input('mag-table', 'selected_rows'),
             Input('sequence-selector', 'value'),
             Input('gene-search-button', 'n_clicks')],
            [State('mag-table', 'data'),
             State('gene-search', 'value')]
        )
        def update_sequence_viewer(selected_rows, selected_sequence, search_clicks, table_data, search_term):
            """Update the sequence viewer."""
            try:
                if not selected_rows or not table_data:
                    return html.Div("Select a MAG from the table to view sequences.", className="alert alert-info")
                
                if not selected_sequence:
                    return html.Div("Select a sequence from the dropdown above.", className="alert alert-info")
                
                selected_mag = table_data[selected_rows[0]]
                mag_id = selected_mag.get("id", "")
                
                if not mag_id or not self.mags_app:
                    return html.Div("Error: Invalid MAG or sequence selection", className="alert alert-danger")
                
                # Get the FASTA data
                try:
                    fasta_data = self.mags_app.get_mag_data().get(mag_id, {}).get("fasta", {})
                    if not fasta_data:
                        return html.Div("No sequence data available for this MAG.", className="alert alert-warning")
                    
                    # Find the selected sequence
                    sequence_data = None
                    for seq in fasta_data:
                        if seq.get("header") == selected_sequence:
                            sequence_data = seq
                            break
                    
                    if not sequence_data:
                        return html.Div(f"Sequence '{selected_sequence}' not found.", className="alert alert-warning")
                    
                    sequence = sequence_data.get("sequence", "")
                    header = sequence_data.get("header", "")
                    
                    # Format the sequence for display
                    formatted_sequence = ""
                    for i in range(0, len(sequence), 60):
                        chunk = sequence[i:i+60]
                        formatted_lines = [chunk[j:j+10] for j in range(0, len(chunk), 10)]
                        formatted_sequence += " ".join(formatted_lines) + "\n"
                    
                    # Handle search if needed
                    highlight_positions = []
                    match_info = ""
                    if search_term and search_clicks:
                        search_term = search_term.upper()
                        sequence_upper = sequence.upper()
                        start_pos = 0
                        match_count = 0
                        while True:
                            pos = sequence_upper.find(search_term, start_pos)
                            if pos == -1:
                                break
                            highlight_positions.append(pos)
                            match_count += 1
                            start_pos = pos + 1
                        
                        if match_count > 0:
                            match_info = f"Found {match_count} matches for '{search_term}'"
                        else:
                            match_info = f"No matches found for '{search_term}'"
                    
                    return html.Div([
                        html.Div(match_info, id="match-info", style={"marginBottom": "10px", "fontWeight": "bold"} if match_info else {"display": "none"}),
                        html.Div([
                            html.Pre([
                                html.Code(
                                    f">{header}\n{formatted_sequence}",
                                    style={"whiteSpace": "pre-wrap", "wordBreak": "break-all"}
                                )
                            ], style={"backgroundColor": "#f5f5f5", "padding": "15px", "borderRadius": "4px", "maxHeight": "500px", "overflowY": "auto"})
                        ], id="sequence-text-content")
                    ])
                    
                except Exception as e:
                    logger.error(f"Error retrieving sequence data: {str(e)}", exc_info=True)
                    return html.Div(f"Error retrieving sequence data: {str(e)}", className="alert alert-danger")
                
            except Exception as e:
                logger.error(f"Error updating sequence viewer: {str(e)}", exc_info=True)
                return html.Div(f"Error: {str(e)}", className="alert alert-danger")

        @self.app.callback(
            Output('copy-status', 'children'),
            [Input('copy-all-button', 'n_clicks'),
             Input('copy-selected-button', 'n_clicks')]
        )
        def copy_sequence_to_clipboard(n_clicks_all, n_clicks_selected):
            """Display appropriate copy instructions."""
            ctx = dash.callback_context
            if not ctx.triggered:
                return ""
            
            button_id = ctx.triggered[0]['prop_id'].split('.')[0]
            
            if button_id == 'copy-all-button':
                return html.Div([
                    html.P("Click in the yellow box, press Cmd+A to select all, then Cmd+C to copy.", 
                          style={'color': 'green', 'fontWeight': 'bold', 'marginBottom': '0px'})
                ])
            elif button_id == 'copy-selected-button':
                return html.Div([
                    html.P("Select the text you want in the yellow box, then press Cmd+C to copy.", 
                          style={'color': 'green', 'fontWeight': 'bold', 'marginBottom': '0px'})
                ])
            
            return ""

