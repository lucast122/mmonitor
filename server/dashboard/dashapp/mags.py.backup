            ])

    def create_dashbio_circos_plot(self, selected_row):
        """Create a DashBio Circos plot for the selected MAG using GFF and FASTA data."""
        try:
            logger.info("Creating DashBio CIRCOS plot")
            
            # Check if a row is selected
            if not selected_row:
                logger.warning("No MAG selected for circos plot")
                return html.Div("Please select a MAG to view its circos plot", className="no-data-message")
            
            # Get MAG name with robust handling
            mag_name = None
            for key in ['Name', 'name', 'id', 'ID']:
                if key in selected_row and selected_row[key]:
                    mag_name = str(selected_row[key])
                    break
            
            if not mag_name:
                logger.error(f"Could not determine MAG name from row: {selected_row}")
                return html.Div("Could not determine MAG name", className="alert alert-danger")
            
            logger.info(f"Creating DashBio CIRCOS plot for MAG: {mag_name}")
            
            # Get MAG data from DataFrame
            mag_data = self.mag_data
            
            # Check if mag_data is valid
            if mag_data is None or mag_data.empty:
                logger.warning("MAG data is empty, trying to reload")
                mag_data = self.get_mag_data()
                if mag_data is None or mag_data.empty:
                    logger.error("Failed to load MAG data")
                    return html.Div("Could not load MAG data", className="alert alert-danger")
            
            # Find the MAG with multiple fallback approaches
            mag_matches = mag_data[mag_data['name'] == mag_name]
            
            # If no exact match, try case-insensitive
            if mag_matches.empty:
                logger.info(f"No exact match for MAG '{mag_name}', trying case-insensitive")
                mag_matches = mag_data[mag_data['name'].astype(str).str.lower() == mag_name.lower()]
            
            # If still no match, try contains
            if mag_matches.empty:
                logger.info(f"No case-insensitive match, trying contains for MAG '{mag_name}'")
                mag_matches = mag_data[mag_data['name'].astype(str).str.contains(mag_name, case=False, na=False)]
            
            if mag_matches.empty:
                logger.error(f"MAG '{mag_name}' not found in database")
                return html.Div(f"MAG '{mag_name}' not found in database", className="alert alert-danger")
            
            # Get the first matching MAG
            mag_record = mag_matches.iloc[0]
            
            # Make sure we have FASTA data for this MAG
            if 'fasta_file' not in mag_record or not mag_record['fasta_file'] or mag_record['fasta_file'] == 'empty':
                logger.error(f"No FASTA data for MAG '{mag_name}'")
                return html.Div(f"No FASTA sequence data available for MAG '{mag_name}'", className="alert alert-danger")
            
            # Check if GFF data is available
            has_annotations = 'gff_file' in mag_record and mag_record['gff_file'] and mag_record['gff_file'] != 'empty'
            
            # Parse FASTA data
            try:
                fasta_data = mag_record['fasta_file']
                sequences = self.parse_fasta_for_viewer(fasta_data)
                
                if not sequences:
                    logger.error("No sequences parsed from FASTA data")
                    return html.Div("No valid sequences found in FASTA data", className="alert alert-danger")
                
                logger.info(f"Found {len(sequences)} contigs in FASTA data")
            except Exception as parse_error:
                logger.error(f"Error parsing FASTA data: {str(parse_error)}", exc_info=True)
                return html.Div(f"Error parsing sequence data: {str(parse_error)}", className="alert alert-danger")
            
            # Prepare data for Circos plot
            try:
                # Sort sequences by length (largest first) and limit to top 50
                sequences.sort(key=lambda x: len(x['sequence']), reverse=True)
                top_sequences = sequences[:50]  # Limit to top 50 largest contigs for visualization
                
                # Create layout data for Circos
                layout_data = []
                for i, seq in enumerate(top_sequences):
                    contig_id = seq['id']
                    contig_length = len(seq['sequence'])
                    
                    # Only include larger contigs
                    if contig_length >= 1000:  # Minimum size filter
                        layout_data.append({
                            'id': contig_id,
                            'len': contig_length,
                            'color': f"hsl({(i * 10) % 360}, 70%, 50%)",
                            'label': contig_id
                        })
                
                # Create GC content heatmap track
                gc_data = []
                for seq in top_sequences:
                    contig_id = seq['id']
                    sequence = seq['sequence']
                    
                    # Calculate GC content in windows
                    window_size = max(5000, int(len(sequence) / 100))  # Adjust window size based on sequence length
                    
                    for start in range(0, len(sequence), window_size):
                        end = min(start + window_size, len(sequence))
                        if end - start < 100:  # Skip very small remaining windows
                            continue
                            
                        window = sequence[start:end]
                        gc_count = window.upper().count('G') + window.upper().count('C')
                        gc_percent = (gc_count / len(window)) * 100 if window else 0
                        
                        # Map GC percentage to a value between 0 and 1 for the heatmap
                        # Typically, GC content ranges from 20-80%, so adjust accordingly
                        value = max(0, min(1, (gc_percent - 20) / 60))
                        
                        gc_data.append({
                            'block_id': contig_id,
                            'start': start,
                            'end': end,
                            'value': value
                        })
                
                # Parse GFF data for gene annotations if available
                highlight_data = []
                if has_annotations:
                    gff_data = mag_record['gff_file']
                    
                    # Get set of contig IDs from layout data for quick lookup
                    layout_contig_ids = {item['id'] for item in layout_data}
                    
                    try:
                        # Parse GFF file
                        for line in gff_data.splitlines():
                            if line.startswith('#') or not line.strip():
                                continue
                                
                            parts = line.split('\t')
                            if len(parts) >= 8:
                                contig_id = parts[0]
                                
                                # Only process features for contigs in our layout
                                if contig_id in layout_contig_ids:
                                    feature_type = parts[2]
                                    start = int(parts[3])
                                    end = int(parts[4])
                                    strand = parts[6]
                                    attributes = parts[8]
                                    
                                    # Only include genes and CDS features
                                    if feature_type.lower() in ['gene', 'cds']:
                                        # Determine color based on strand
                                        color = "rgba(0, 150, 0, 0.7)" if strand == '+' else "rgba(150, 0, 0, 0.7)"
                                        
                                        # Get gene name if available
                                        gene_name = None
                                        for attr in attributes.split(';'):
                                            if '=' in attr:
                                                key, value = attr.split('=', 1)
                                                if key.lower() in ['name', 'gene', 'product', 'id']:
                                                    gene_name = value
                                                    break
                                        
                                        highlight_data.append({
                                            'block_id': contig_id,
                                            'start': start,
                                            'end': end,
                                            'color': color,
                                            'opacity': 0.7,
                                            # Use object format for tooltips
                                            'tooltipContent': {
                                                'Name': gene_name or "Unknown",
                                                'Type': feature_type,
                                                'Position': f"{start}-{end}",
                                                'Strand': strand
                                            }
                                        })
                        
                        logger.info(f"Parsed {len(highlight_data)} gene annotations from GFF data")
                    except Exception as gff_error:
                        logger.error(f"Error parsing GFF data: {str(gff_error)}", exc_info=True)
                        # Continue without annotations
                
                # Create Circos component with the data
                if layout_data:
                    circos = dashbio.Circos(
                        id='circos-plot',  # Match the ID used in callbacks
                        layout=layout_data,
                        size=800,
                        tracks=[
                            # GC Content track
                            {
                                'type': 'HEATMAP',
                                'data': gc_data,
                                'config': {
                                    'innerRadius': 0.8,
                                    'outerRadius': 0.9,
                                    'colorScale': 'viridis',
                                    'tooltipContent': {
                                        'GC Content': 'value * 100 + "%"'
                                    }
                                }
                            },
                            # Gene annotation track (if available)
                            {
                                'type': 'HIGHLIGHT',
                                'data': highlight_data,
                                'config': {
                                    'innerRadius': 0.5,
                                    'outerRadius': 0.75,
                                    'tooltipContent': [
                                        {
                                            'name': 'Name', 
                                            'value': 'tooltipContent.Name'
                                        },
                                        {
                                            'name': 'Type', 
                                            'value': 'tooltipContent.Type'
                                        },
                                        {
                                            'name': 'Position', 
                                            'value': 'tooltipContent.Position'
                                        },
                                        {
                                            'name': 'Strand', 
                                            'value': 'tooltipContent.Strand'
                                        }
                                    ]
                                }
                            }
                        ]
                    )
                    
                    # Create a div with both the plot and some statistics
                    return html.Div([
                        html.H5(f"Circos Plot - {mag_name}"),
                        html.Div([
                            html.Div([
                                html.H6("Genome Statistics"),
                                html.Table([
                                    html.Tr([html.Td("Total Contigs:"), html.Td(f"{len(sequences)}")]),
                                    html.Tr([html.Td("Displayed Contigs:"), html.Td(f"{len(layout_data)}")]),
                                    html.Tr([html.Td("Total Genome Size:"), html.Td(f"{sum(len(seq['sequence']) for seq in sequences):,} bp")]),
                                    html.Tr([html.Td("Largest Contig:"), html.Td(f"{max(len(seq['sequence']) for seq in sequences):,} bp")]),
                                    html.Tr([html.Td("GC Content:"), html.Td(f"{self._calculate_overall_gc(sequences):.1f}%")]),
                                    html.Tr([html.Td("Genes:"), html.Td(f"{len(highlight_data)}" if highlight_data else "No annotation data")])
                                ], style={'marginBottom': '20px'})
                            ], style={'width': '25%', 'display': 'inline-block', 'verticalAlign': 'top', 'padding': '10px'}),
                            html.Div([
                                circos
                            ], style={'width': '75%', 'display': 'inline-block', 'verticalAlign': 'top'})
                        ], style={'display': 'flex', 'flexWrap': 'wrap'})
                    ])
                else:
                    return html.Div("No contigs of sufficient size found for visualization", className="alert alert-warning")
                    
            except Exception as plot_error:
                logger.error(f"Error creating DashBio CIRCOS plot: {str(plot_error)}", exc_info=True)
                return html.Div([
                    html.Div(f"Error creating CIRCOS plot: {str(plot_error)}", className="alert alert-danger"),
                    html.Pre(f"Full error details:\n{traceback.format_exc()}", 
                            style={"maxHeight": "200px", "overflow": "auto", "whiteSpace": "pre-wrap"})
                ])
                
        except Exception as e:
            logger.error(f"Error in create_dashbio_circos_plot: {str(e)}", exc_info=True)
            return html.Div([
                html.H5("Error Creating CIRCOS Plot", className="alert-heading"),
                html.P(f"An error occurred: {str(e)}"),
                html.P("Try reloading the page or selecting a different MAG.")
            ], className="alert alert-danger")
            
    def _calculate_overall_gc(self, sequences):
        """Calculate the overall GC content percentage across all sequences."""
        total_gc = 0
        total_length = 0
        
        for seq in sequences:
            sequence = seq['sequence'].upper()
            gc_count = sequence.count('G') + sequence.count('C')
            total_gc += gc_count
            total_length += len(sequence)
            
        if total_length == 0:
            return 0
            
        return (total_gc / total_length) * 100
